+    atom_feat = np.zeros((mol.GetNumAtoms(), num_atom_feat))
+    for atom in mol.GetAtoms():
+        atom_feat[atom.GetIdx(), :] = atom_features(atom)
+    adj_matrix = adjacent_matrix(mol)
+    return atom_feat, adj_matrix
