+    TN = CM[0][0]
+    FP = CM[0][1]
+    FN = CM[1][0]
+    TP = CM[1][1]
+    Rec = TP / (TP + FN)
+    Pre = TP / (TP + FP)
+    F1 = 2 * Pre * Rec / (Pre + Rec)
+    MCC = matthews_corrcoef(correct_labels, predicted_labels)
+    precision, recall, _ = precision_recall_curve(correct_labels, predicted_scores)
+    PRC = auc(recall, precision)
